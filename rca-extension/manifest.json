{
  "manifest_version": 3,
  "name": "RCA Analysis",
  "version": "1.0.0",
  "description": "Auto-generate Root Cause Analysis from Slack and Salesforce case data",
  "permissions": ["storage", "activeTab", "tabs", "sidePanel"],
  "side_panel": {
    "default_path": "popup.html"
  },
  "host_permissions": [
    "http://127.0.0.1:3001/*",
    "https://*.slack.com/*",
    "https://*.salesforce.com/*",
    "https://help.salesforce.com/*",
    "https://status.salesforce.com/*"
  ],
  "action": {
    "default_title": "RCA Analysis",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "web_accessible_resources": [{
    "resources": ["preview.html", "preview.js", "preview-fns.js"],
    "matches": ["<all_urls>"]
  }]
}
